NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/lifeos_dev
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_for_access_token
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_string_for_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_64_char_random_hex_string_for_cookies
CLIENT_URL=http://localhost:3000
REMEMBER_ME_EXPIRES_DAYS=30
SESSION_EXPIRES_DAYS=7
EMAIL_FROM=noreply@lifeos.app
EMAIL_FROM_NAME=LifeOS
RESEND_API_KEY=your_resend_api_key_here
BCRYPT_ROUNDS=12
